@model Bolsa.Entities.Plaza

@{
    ViewData["Title"] = "Detalles de la Plaza";
}

<div class="container mt-4">
    <h2>Detalles de la Plaza</h2>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="card-title text-primary">@Model.Titulo</h3>
            <h5 class="card-subtitle mb-3 text-muted">Empresa / Institución: @Model.Institucion</h5>

            <p class="card-text"><strong>Descripción del Puesto:</strong></p>
            <p class="p-3 bg-light rounded">@Model.Descripcion</p>

            <div class="row mt-4">
                <div class="col-md-4">
                    <p><strong>Fecha de Publicación:</strong><br /> @Model.FechaPublicacion.ToShortDateString()</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Fecha de Cierre:</strong><br /> @Model.FechaCierre.ToShortDateString()</p>
                </div>
                <div class="col-md-4">
                    <p>
                        <strong>Estado Actual:</strong><br />
                        <span class="badge bg-@(Model.Estado == "Abierta" ? "success" : "secondary")">@Model.Estado</span>
                    </p>
                </div>
            </div>

            <div class="mt-4">
                @if (User.IsInRole("Administrador") || User.IsInRole("Agente"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.IdPlaza" class="btn btn-warning">Editar Plaza</a>
                }
                <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
            </div>
        </div>
    </div>
</div>