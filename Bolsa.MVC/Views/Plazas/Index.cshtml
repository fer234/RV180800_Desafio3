@model IEnumerable<Bolsa.Entities.Plaza>

@{
    ViewData["Title"] = "Plazas Disponibles";
}

<div class="container mt-4">
    <h2>Plazas de Trabajo Disponibles en El Salvador</h2>

    <p class="mt-3">
        <a asp-action="Create" class="btn btn-primary">Crear Nueva Plaza</a>
    </p>

    <table class="table table-striped table-hover mt-3 shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Titulo</td>
                        <td>@item.Descripcion</td>
                        <td>
                            <span class="badge @(item.Estado == "Abierta" ? "bg-success" : "bg-secondary")">
                                @item.Estado
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.IdPlaza" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdPlaza" class="btn btn-sm btn-info text-white">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.IdPlaza" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No hay plazas registradas todavía. ¡Crea una nueva!</td>
                </tr>
            }
        </tbody>
    </table>
</div>