@model IEnumerable<Bolsa.Entities.Postulacion>

@{
    ViewData["Title"] = "Listado de Postulaciones";
}

<div class="container mt-4">
    <h2>Listado de Postulaciones</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <p>
        <a asp-action="Create" class="btn btn-success">Crear Nueva Postulación</a>
    </p>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID Postulación</th>
                <th>ID Plaza</th>
                <th>Candidato</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdPostulacion</td>
                        <td><span class="badge bg-secondary">Plaza #@item.IdPlaza</span></td>
                        <td>@item.IdCandidato</td>
                        <td>@item.FechaPostulacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge bg-info text-dark">@item.Estado</span></td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.IdPostulacion" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdPostulacion" class="btn btn-info btn-sm">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.IdPostulacion" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay postulaciones registradas todavía.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a class="btn btn-primary" asp-controller="Plazas" asp-action="Index">Ver Plazas Disponibles</a>
    </div>
</div>