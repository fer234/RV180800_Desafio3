@model Bolsa.Entities.HojaDeVida

@{
    ViewData["Title"] = "Eliminar Hoja de Vida";
}

<div class="container mt-4">
    <h2>Eliminar Hoja de Vida</h2>
    <h3 class="text-danger">¿Estás seguro de que deseas eliminar este registro?</h3>
    <hr />
    <div>
        <dl class="row">
            <dt class="col-sm-3 fw-bold">ID CV:</dt>
            <dd class="col-sm-9">@Model.IdCV</dd>

            <dt class="col-sm-3 fw-bold">Usuario:</dt>
            <dd class="col-sm-9">@Model.IdUsuario</dd>

            <dt class="col-sm-3 fw-bold">Formación Académica:</dt>
            <dd class="col-sm-9">@Model.FormacionAcademica</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="IdCV" />
            <input type="submit" value="Eliminar definitivamente" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>